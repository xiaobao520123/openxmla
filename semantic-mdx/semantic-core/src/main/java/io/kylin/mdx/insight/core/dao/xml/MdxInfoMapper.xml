<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="io.kylin.mdx.insight.core.dao.MdxInfoMapper">

    <resultMap id="MdxInfoResultMap" type="io.kylin.mdx.insight.core.entity.MdxInfo">
        <id column="id" property="id" jdbcType="INTEGER"/>
        <result column="mdx_version" property="mdxVersion" jdbcType="VARCHAR"/>
    </resultMap>

    <!-- 通用版本查询，适用于大多数数据库 -->
    <select id="getDatabaseVersion" resultType="java.lang.String" databaseId="mysql">
        select version();
    </select>

    <!-- SQL Server 专用版本查询 -->
    <select id="getDatabaseVersion" resultType="java.lang.String" databaseId="sqlserver">
        SELECT @@VERSION
    </select>

    <!-- 其他数据库的备用版本查询 -->
    <select id="getDatabaseVersion" resultType="java.lang.String">
        SELECT version() FROM dual
    </select>

</mapper>